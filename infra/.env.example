# Copy to infra/.env on the host (never commit real secrets).
# Docker Compose host stack reads these via --env-file infra/.env

# Postgres password for cms-db (must match ConnectionStrings password below)
LCMS_DB_PASSWORD=change-me

# Optional: override full connection string for local/non-compose runs
# ConnectionStrings__LcmsDb=Host=localhost;Port=5432;Database=lcms;Username=lcms;Password=change-me

# ASP.NET
# ASPNETCORE_ENVIRONMENT=Production
# Database__MigrateOnStartup=true
