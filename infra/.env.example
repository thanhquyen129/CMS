# Copy to infra/.env on the host (never commit real secrets).
# Docker Compose host stack reads these via --env-file infra/.env

LCMS_DB_PASSWORD=change-me

# JWT (Production RequireJwt=true — ≥32 chars; never commit real value)
Auth__Jwt__SigningKey=change-me-to-long-random-string-at-least-32-chars

# Optional UI-0 operator bootstrap (creates/refreshes tenant+user on API startup)
# Auth__Bootstrap__Email=ops@example.com
# Auth__Bootstrap__Password=set-a-strong-password
# Auth__Bootstrap__DisplayName=Operator
# Auth__Bootstrap__TenantCode=ops
# Auth__Bootstrap__TenantName=Vận hành

# Web cookie Secure flag (false while edge is HTTP-only)
# AUTH_COOKIE_SECURE=false
