# Địa chỉ máy chủ LCMS API (Ưu tiên 1 / Production chính: https://cms.lsslogistics.vn)
EXPO_PUBLIC_API_URL=https://cms.lsslogistics.vn

# Mã thuê bao mặc định khi mở màn hình đăng nhập
EXPO_PUBLIC_DEFAULT_TENANT=ops

# Hiển thị danh sách chọn nhanh 7 tài khoản Demo Persona ("true" hoặc "false")
EXPO_PUBLIC_SHOW_DEMO_PERSONAS=true
