{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "LcmsDb": "Data Source=lcms_dev.db"
  },
  "Auth": {
    "RequireJwt": false,
    "AllowHeaderBootstrap": true,
    "Jwt": {
      "Issuer": "lcms-api",
      "Audience": "lcms-api",
      "ExpiryMinutes": 120,
      "SigningKey": "lcms-dev-only-signing-key-min-32-chars!"
    },
    "RoleDemoUsers": {
      "Enabled": true,
      "Password": "abc123",
      "TenantCode": "ops"
    }
  },
  "Demo": {
    "SeedOnStartup": true,
    "AllowEndpoint": true,
    "TenantCode": "ops"
  }
}
